# Copy to .env and fill in real values. NEVER commit .env to git.
# Backend runs on PORT (default 5000); the Vite dev server proxies /api to it.

PORT=5000

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Example format only — replace with your own cluster, user and password:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/classtrack?retryWrites=true&w=majority

# JWT secrets — generate long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Frontend origin allowed by CORS (dev default is http://localhost:5173).
CLIENT_URL=http://localhost:5173

# WhatsApp alerts: 'false' = log mode (no messages sent, safe default).
# Set to 'true' only after a provider is wired into utils/whatsapp.js (see NOTES.md).
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
